# Environment Variables Example for Virtual AI Assistant

# ================================
# Backend (Server) Configuration
# ================================
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database (SQLite default for zero-config local run; or PostgreSQL)
DATABASE_URL="file:./dev.db"

# =========================================================================
# Google Custom Search API (for live web search integration)
# =========================================================================
# 1. Google API Key: https://console.cloud.google.com/apis/credentials (Enable Custom Search API)
# 2. Search Engine ID (cx): https://programmablesearchengine.google.com/ (Search the entire web)
GOOGLE_API_KEY=
GOOGLE_SEARCH_ENGINE_ID=

# SerpAPI (Optional fallback)
SERPAPI_API_KEY=

# =========================================================================
# LLM Providers (Claude, Gemini, or OpenAI)
# =========================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022
GEMINI_API_KEY=
OPENAI_API_KEY=

# Authentication Secrets (JWT)
JWT_ACCESS_SECRET=super_secret_access_jwt_key_change_in_production_min_32_chars
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_change_in_production_min_32_chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security & Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200

# ================================
# Frontend (Client) Configuration
# ================================
VITE_API_URL=http://localhost:5000/api/v1
