PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173

# Database URL (SQLite default for zero-config local run; or PostgreSQL)
DATABASE_URL="file:./dev.db"

# =========================================================================
# Google Custom Search API (for live web search integration)
# =========================================================================
# 1. Get Google API Key: https://console.cloud.google.com/apis/credentials
#    Enable "Custom Search API" in Google Cloud Console
# 2. Get Search Engine ID (cx): https://programmablesearchengine.google.com/
#    Turn ON "Search the entire web" in the search engine control panel
GOOGLE_API_KEY=your_google_cloud_custom_search_api_key
GOOGLE_SEARCH_ENGINE_ID=your_programmable_search_engine_cx_id

# SerpAPI (Optional fallback for Google search)
SERPAPI_API_KEY=

# =========================================================================
# LLM Providers (Claude, Gemini, or OpenAI)
# =========================================================================
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

GEMINI_API_KEY=
OPENAI_API_KEY=

# Authentication Secrets (JWT)
JWT_ACCESS_SECRET=your_super_secret_access_jwt_key_at_least_32_characters_long
JWT_REFRESH_SECRET=your_super_secret_refresh_jwt_key_at_least_32_characters_long
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Rate Limiter
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=200
